.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 40rpx 40rpx;
}

.empty-state.is-compact {
  padding: 100rpx 40rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  background: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.is-compact .empty-icon {
  width: 120rpx;
  height: 120rpx;
}

.empty-icon-text {
  font-size: 72rpx;
}

.is-compact .empty-icon-text {
  font-size: 56rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #666;
  margin-top: 32rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
  text-align: center;
}
