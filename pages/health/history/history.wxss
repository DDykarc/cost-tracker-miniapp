.page {
  padding: 20rpx;
  min-height: 100vh;
  background: #F5F6FA;
}

/* 时间范围筛选栏 */
.filter-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0 12rpx;
  margin-bottom: 12rpx;
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  font-weight: 500;
  color: #666;
  background: #FFFFFF;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.filter-tab.active {
  background: linear-gradient(135deg, #00C853, #69F0AE);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(0, 200, 83, 0.25);
}

/* 统计摘要卡片 */
.stats-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.stats-high {
  color: #D32F2F;
}

.stats-low {
  color: #388E3C;
}

.stats-avg {
  color: #1976D2;
}

.stats-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.stats-divider {
  width: 2rpx;
  height: 40rpx;
  background: #F0F0F0;
}

.record-list {
  margin-bottom: 40rpx;
}

.record-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.record-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.record-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 80rpx;
  margin-top: -4rpx;
}

.record-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
  line-height: 80rpx;
}

.record-unit {
  font-size: 24rpx;
  color: #999;
  line-height: 80rpx;
}

.record-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 500;
  height: 40rpx;
  padding: 0 16rpx 16rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
  line-height: 1;
}

.status-normal {
  background: #E8F5E9;
  color: #388E3C;
}

.status-high {
  background: #FFEBEE;
  color: #D32F2F;
}

.status-low {
  background: #FFF3E0;
  color: #F57C00;
}

.record-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-timing {
  font-size: 22rpx;
  color: #666;
  background: #F5F6FA;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.record-medicated {
  font-size: 22rpx;
  color: #388E3C;
  background: #E8F5E9;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.record-medicated-none {
  font-size: 22rpx;
  color: #999;
  background: #F5F6FA;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.record-note {
  background: #F9F9F9;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  width: 100%;
  box-sizing: border-box;
}

.note-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.record-delete {
  font-size: 24rpx;
  color: #F44336;
  padding: 8rpx 0 8rpx 24rpx;
  white-space: nowrap;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.loading {
  text-align: center;
  padding: 60rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}
