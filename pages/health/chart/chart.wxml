<view class="page">
  <!-- 加载失败 -->
  <error-state wx:if="{{error}}" message="{{error.message}}" retryable="{{error.retryable}}" bind:retry="loadData" />

  <!-- 周期切换 -->
  <view class="period-bar">
    <view class="period-item {{period === item.key ? 'active' : ''}}" wx:for="{{periods}}" wx:key="key" data-key="{{item.key}}" bindtap="onSelectPeriod">{{item.label}}</view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-card">
    <view class="stat-box">
      <text class="stat-num">{{stats.max}}</text>
      <text class="stat-label">最高{{typeName}}</text>
    </view>
    <view class="stat-box">
      <text class="stat-num">{{stats.min}}</text>
      <text class="stat-label">最低{{typeName}}</text>
    </view>
    <view class="stat-box">
      <text class="stat-num">{{stats.avg}}</text>
      <text class="stat-label">平均{{typeName}}</text>
    </view>
  </view>

  <!-- 图表区域 -->
  <view class="chart-card" id="chart-container">
    <view class="chart-header">
      <text class="chart-title">{{typeName}}趋势</text>
      <text class="chart-unit">单位：{{unit}}</text>
    </view>
    <view class="chart-wrap">
      <canvas type="2d" id="trendChart" style="height: 400rpx;" 
              bindtouchstart="onTouchStart" 
              bindtouchmove="onTouchMove" 
              bindtouchend="onTouchEnd"></canvas>
      <view class="chart-tooltip" wx:if="{{tooltipShow}}" style="left:{{tooltipX}}px;top:{{tooltipY}}px;">
        <text>{{tooltipText}}</text>
      </view>
    </view>
    <view class="chart-empty" wx:if="{{records.length < 2}}">
      <text class="empty-text">数据不足，无法生成图表</text>
      <text class="empty-hint">至少需要2条记录</text>
    </view>
  </view>

  <!-- 参考范围（数值来自 utils/config.js，与状态判定共用同一份数据） -->
  <view class="ref-card" wx:if="{{refText}}">
    <text class="ref-title">参考范围</text>
    <view class="ref-item">
      <text class="ref-label">{{refLabel}}</text>
      <text class="ref-value">{{refText}}</text>
    </view>
  </view>
</view>
