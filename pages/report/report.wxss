/* 消费报告页面样式 */
.page {
  min-height: 100vh;
  background: #F5F6FA;
  padding-bottom: 40rpx;
}

/* 模式切换 */
.mode-switch {
  display: flex;
  justify-content: center;
  gap: 0;
  padding: 24rpx 20rpx 0;
}

.mode-tab {
  padding: 14rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #999;
  background: #FFFFFF;
  border: 2rpx solid #E0E0E0;
}

.mode-tab:first-child {
  border-radius: 12rpx 0 0 12rpx;
  border-right: none;
}

.mode-tab:last-child {
  border-radius: 0 12rpx 12rpx 0;
}

.mode-tab.active {
  background: linear-gradient(135deg, #00C853, #69F0AE);
  color: #FFFFFF;
  border-color: #00C853;
}

/* 时间导航 */
.period-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  padding: 28rpx 0 16rpx;
}

.nav-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #00C853;
  background: #FFFFFF;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.nav-arrow:active {
  opacity: 0.7;
}

.period-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  min-width: 200rpx;
  text-align: center;
}

/* 概览统计 */
.summary-card {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin: 16rpx 20rpx;
  padding: 28rpx 20rpx;
  background: linear-gradient(135deg, #00C853 0%, #69F0AE 100%);
  border-radius: 20rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.summary-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.summary-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
}

.summary-divider {
  width: 2rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 图表卡片 */
.chart-card {
  padding: 24rpx;
}

.card-title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.report-canvas {
  width: 100%;
  height: 400rpx;
}

/* 分类明细 */
.detail-card {
  padding: 24rpx;
}

.cat-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.cat-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.cat-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 200rpx;
}

.cat-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.cat-icon {
  font-size: 28rpx;
}

.cat-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.cat-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-left: auto;
}

.cat-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.cat-percent {
  font-size: 22rpx;
  color: #999;
  min-width: 60rpx;
  text-align: right;
}

.cat-bar-bg {
  width: 100%;
  height: 8rpx;
  background: #F0F0F0;
  border-radius: 4rpx;
  margin-top: 4rpx;
}

.cat-bar-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* 月度明细 */
.month-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.month-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.month-label {
  font-size: 24rpx;
  color: #666;
  min-width: 60rpx;
  text-align: right;
}

.month-bar-bg {
  flex: 1;
  height: 24rpx;
  background: #F0F0F0;
  border-radius: 12rpx;
  overflow: hidden;
}

.month-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #00C853, #69F0AE);
  border-radius: 12rpx;
  transition: width 0.3s ease;
  min-width: 4rpx;
}

.month-amount {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  min-width: 80rpx;
  text-align: right;
}

/* Top 5 */
.top-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.top-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.top-row:last-child {
  border-bottom: none;
}

.top-rank {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F0F0F0;
  font-size: 24rpx;
  font-weight: 600;
  color: #999;
}

.top-row:first-child .top-rank {
  background: #00C853;
  color: #FFFFFF;
}

.top-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.top-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.top-cat {
  font-size: 22rpx;
  color: #999;
}

.top-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #00C853;
}
